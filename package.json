{
	"author": {
		"name": "Baptiste Pillot",
		"email": "baptiste@pillot.fr"
	},
	"dependencies": {
		"@itrocks/action-pack": "latest",
		"@itrocks/auto-redirect": "latest",
		"@itrocks/business-pack": "latest",
		"@itrocks/config": "latest",
		"@itrocks/core-responses": "latest",
		"@itrocks/edit": "latest",
		"@itrocks/output": "latest",
		"@itrocks/sql-functions": "latest",
		"@itrocks/storage": "latest",
		"@itrocks/translate": "latest",
		"@itrocks/unique": "latest",
		"@itrocks/user": "latest",
		"html-to-text": "^9.0",
		"nodemailer": "^9.0"
	},
	"description": "Forgot password management for @itrocks/user, including form, token generation, email sending, and secure reset",
	"devDependencies": {
		"@types/html-to-text": "^9.0",
		"@types/node": "^24.1",
		"@types/nodemailer": "^7.0",
		"sass": "^1.95",
		"typescript": "^7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": "./cjs/forgot.js",
	"homepage": "https://it.rocks",
	"files": [
		"config.yaml",
		"docs",
		"LICENSE",
		"README.md",
		"cjs",
		"css",
		"!*.map"
	],
	"keywords": [
		"account",
		"action",
		"API",
		"authentication",
		"backend",
		"component",
		"forgot",
		"forgot-password",
		"html",
		"it.rocks",
		"json",
		"password",
		"recovery",
		"reset",
		"security",
		"standard",
		"token",
		"user",
		"view"
	],
	"license": "ISC",
	"name": "@itrocks/forgot-password",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/forgot-password.git"
	},
	"scripts": {
		"build": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.html'))fs.copyFileSync(path.join('src',file),path.join('cjs',file))\" && npm run build:css",
		"build:css": "sass --no-source-map src:css && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.svg'))fs.copyFileSync(path.join('src',file),path.join('css',file))\"",
		"test": "npm run build && node --test --test-isolation=none test/*.test.js"
	},
	"version": "0.4.4"
}
